# Application Configuration
PORT=3000
NODE_ENV=development

# CORS - set to the URL where the frontend is served
CORS_ORIGIN=http://localhost:8080

# Session Configuration - change this to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Database Configuration (used locally)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=express_db

# PostgreSQL (used by Docker and pg pool)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=express_db
POSTGRES_PORT=5432
POSTGRES_HOST=db
